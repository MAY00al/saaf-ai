# Copy to a local .env in the repository root. Run the backend from that root.
OPENAI_API_KEY=
# Set your own Gemini Developer API key here when using Gemini.
GOOGLE_API_KEY=
SAAF_CHAT_PROVIDER=openai
SAAF_EMBEDDING_PROVIDER=openai
# Blank uses the selected provider default.
SAAF_CHAT_MODEL=
SAAF_EMBEDDING_MODEL=
SAAF_CHROMA_DIR=var/chroma
SAAF_SQLITE_PATH=var/saaf.sqlite3
# Trusted checkpoint shipped in the private team repository.
SAAF_PALM_WEIGHTS=models/best.pt
SAAF_PALM_CONFIDENCE=0.25
SAAF_PALM_IMAGE_SIZE=640
SAAF_PALM_MAX_DETECTIONS=3000
SAAF_PALM_OUTPUT_DIR=var/monitoring
SAAF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAAF_SESSION_TTL_SECONDS=3600
# Set a registered project you are authorized to use after earthengine authenticate.
SAAF_EE_PROJECT=
# Optional alternative to individual login. Keep the key file outside the repository.
SAAF_EE_SERVICE_ACCOUNT_FILE=
