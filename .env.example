# Copy to .env for AI commands or export settings in your shell.
OPENAI_API_KEY=
GOOGLE_API_KEY=
SAAF_CHAT_PROVIDER=openai
SAAF_EMBEDDING_PROVIDER=openai
# Blank uses the selected provider default.
SAAF_CHAT_MODEL=
SAAF_EMBEDDING_MODEL=
SAAF_CHROMA_DIR=var/chroma
SAAF_SQLITE_PATH=var/saaf.sqlite3
SAAF_PALM_WEIGHTS=
SAAF_PALM_CONFIDENCE=0.25
SAAF_PALM_IMAGE_SIZE=640
SAAF_PALM_MAX_DETECTIONS=3000
SAAF_PALM_OUTPUT_DIR=var/monitoring
